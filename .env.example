# Required: MongoDB Atlas connection string with a database name.
# URL-encode reserved characters in the username and password.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE?retryWrites=true&w=majority

# Optional notification settings. SMS is disabled until a provider adapter is implemented.
CLIENT_PHONE=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=

# Optional future bot/rate-limit integrations
TURNSTILE_SECRET_KEY=
RATE_LIMIT_API_URL=
RATE_LIMIT_API_TOKEN=

