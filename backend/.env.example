JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_FULL_NAME=System Administrator
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Optional future notification provider settings
CLIENT_PHONE=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=
