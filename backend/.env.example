PORT=5000
NODE_ENV=development

# MongoDB Atlas
# Include the database name after the host. URL-encode username/password characters reserved in URIs.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&appName=<app-name>
# Optional comma-separated DNS resolvers used by Node for mongodb+srv SRV lookups.
MONGODB_DNS_SERVERS=1.1.1.1,1.0.0.1,8.8.8.8,8.8.4.4

# Email
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
ADMIN_EMAIL=
ADMIN_PHONE=

# Admin bootstrap
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator

# Auth
JWT_SECRET=

# Frontend
FRONTEND_URL=https://home-sell-direct.vercel.app

# ClickSend SMS
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_FROM_NUMBER=
RECIPIENT_PHONE=
SEND_SMS=false

# Deployment / CORS
# Comma-separated list of origins allowed to call this API in addition to FRONTEND_URL.
# e.g. https://home-sell-direct.vercel.app,https://www.homeselldirect.com
ALLOWED_ORIGINS=
# Set to false to stop auto-allowing *.vercel.app preview deployments.
ALLOW_VERCEL_PREVIEWS=true

# Google Gemini chat assistant
# Get a key at https://aistudio.google.com/apikey - keep it server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Max chat messages per IP per minute.
CHAT_RATE_LIMIT_PER_MIN=10
# Set to true to persist chat transcripts to the ChatLog collection.
CHAT_LOG_ENABLED=false
# Days to retain transcripts when logging is enabled.
CHAT_LOG_TTL_DAYS=90

# Number of proxy hops to trust for client IPs (Render/Railway/Fly = 1).
TRUST_PROXY_HOPS=1

# Contact form
# Successful contact-form submissions allowed per IP per 15 minutes.
CONTACT_RATE_LIMIT=5

# Supabase (secondary store for lead contact details)
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# SECRET / service-role key. Bypasses row level security - backend only,
# never expose this to the frontend or commit a real value.
SUPABASE_SECRET_KEY=
# Milliseconds before a stalled Supabase insert is abandoned.
SUPABASE_TIMEOUT_MS=5000
